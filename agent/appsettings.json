{
  "Agent": {
    "ServiceName": "Guardian EDR Agent",
    "ShutdownTimeoutSeconds": 30
  },
  "Registration": {
    "BackendBaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 15
  },
  "Heartbeat": {
    "FallbackIntervalSeconds": 300
  },
  "ProcessMonitoring": {
    "Enabled": true,
    "FallbackScanIntervalSeconds": 5
  },
  "ProcessEventTransmission": {
    "QueueCapacity": 500,
    "RetryDelaySeconds": 10
  },
  "FileMonitoring": {
    "Enabled": true,
    "MonitorDownloads": true,
    "MonitorDesktop": true,
    "MonitorTemporaryDirectory": true,
    "IncludeSubdirectories": false,
    "DuplicateWindowMilliseconds": 750,
    "InternalBufferSize": 32768,
    "MaximumDirectories": 16,
    "AdditionalPaths": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
