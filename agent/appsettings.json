  "Agent": {
    "ServiceName": "Guardian EDR Agent",
    "ShutdownTimeoutSeconds": 30
  },
  "Registration": {
    "BackendBaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 15
  },
  "Heartbeat": {
    "FallbackIntervalSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
